cmd-weatherremove-desc = 从地图移除指定天气。
cmd-weatherset-desc = 移除指定天气以外的所有天气。如果地图上不存在指定天气，则添加该天气。
cmd-weatheradd-desc = 向地图添加指定天气。

cmd-weatherremove-help = 用法：weatherremove <mapId> <prototype>
cmd-weatherset-help = 用法：weatherset <mapId> <prototype / null>
cmd-weatheradd-help = 用法：weatheradd <mapId> <prototype / null>

cmd-weather-error-no-arguments = 参数不足！
cmd-weather-error-unknown-proto = 未知的天气原型！
cmd-weather-error-wrong-time = 时间格式错误！
cmd-weather-error-wrong-map = MapId 为 {$id} 的地图不存在！
cmd-weather-error-no-weather = 所选地图上不存在这种天气！

cmd-weather-hint-map-id = 地图 ID
cmd-weather-hint-prototype = 天气实体原型
cmd-weather-hint-time = 持续秒数（留空表示无限持续）
