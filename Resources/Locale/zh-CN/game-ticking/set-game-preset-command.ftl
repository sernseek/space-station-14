set-game-preset-command-description = 为接下来指定数量的回合设置游戏预设。也可以在大厅中显示另一个预设的标题和描述，以迷惑玩家。
set-game-preset-command-help-text = setgamepreset <id> [回合数，默认为 1] [诱饵预设]
set-game-preset-command-hint-1 = <id>
set-game-preset-command-hint-2 = [回合数]
set-game-preset-command-hint-3 = [诱饵预设]

set-game-preset-optional-argument-not-integer = 如果提供参数 2，它必须是一个数字。
set-game-preset-preset-error = 无法找到游戏预设“{$preset}”
set-game-preset-decoy-error = 如果提供参数 3，它必须是一个有效的预设。无法找到游戏预设“{$preset}”

#set-game-preset-preset-set = Set game preset to "{$preset}"
set-game-preset-preset-set-finite = 已将游戏预设设为“{$preset}”，持续接下来的 {$rounds} 个回合。
set-game-preset-preset-set-finite-with-decoy = 已将游戏预设设为“{$preset}”，持续接下来的 {$rounds} 个回合，并在大厅中显示 {$decoy}。
