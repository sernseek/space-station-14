cmd-nightshift-desc = 覆盖所有空间站或单个空间站的夜班照明。

cmd-nightshift-help = 用法：nightshift <Auto|Day|Night> [station]
    自动会跟随空间站时间与事件；白天和夜晚会强制该照明，直到改回自动。

cmd-nightshift-hint-mode = <Auto|Day|Night>

cmd-nightshift-hint-station = [station]

cmd-nightshift-invalid-mode = “{ $mode }”不是照明模式，请使用 Auto、Day 或 Night。

cmd-nightshift-invalid-station = “{ $station }”不是空间站。

cmd-nightshift-success-all = 将所有空间站的夜班设为 { $mode }。

cmd-nightshift-success = 将 { $station } 的夜班设为 { $mode }。
