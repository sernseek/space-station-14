## 伤害命令本地化。

damage-command-description = 为实体增加或移除伤害。
damage-command-help = 用法：{$command} <type/group> <amount> [ignoreResistances] [uid]

damage-command-arg-type = <伤害类型或伤害组>
damage-command-arg-quantity = [数量]
damage-command-arg-target = [目标 euid]

damage-command-error-type = {$arg} 不是有效的伤害组或伤害类型。
damage-command-error-euid = {$arg} 不是有效的实体 uid。
damage-command-error-quantity = {$arg} 不是有效的数量。
damage-command-error-bool = {$arg} 不是有效的布尔值。
damage-command-error-player = 会话未附加任何实体。你必须指定一个目标 uid
damage-command-error-args = 参数数量无效
