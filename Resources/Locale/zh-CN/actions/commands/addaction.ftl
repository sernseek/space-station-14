# addaction
cmd-addaction-desc = 为目标实体添加一个技能。如果该技能要求目标实体具备额外的组件（例如龙的"吞噬"），则技能将不会生效。
cmd-addaction-help = addaction <EntityUid> <ActionPrototype>

cmd-addaction-invalid-args = 正好需要 2 个参数。
cmd-addaction-actions-not-found = 目标实体无法使用技能。
cmd-addaction-action-not-found = 找不到匹配的技能原型 {$action}。
cmd-addaction-adding-failed = 添加技能失败。

cmd-addaction-player-completion = <EntityUid>
cmd-addaction-action-completion = <ActionProto>
