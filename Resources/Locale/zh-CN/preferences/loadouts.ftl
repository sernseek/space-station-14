# Name
loadout-name-edit-label = 设置扮演此角色时使用的自定义名字。若留空，则改用你角色的名字。
loadout-name-edit-label-dataset = 设置扮演此角色时使用的自定义名字。若留空，则改为随机选取一个名字。
loadout-name-edit-tooltip = 最多 {$max} 个字符。若未指定名字，可能会为你随机选择一个。

# Restrictions
loadout-restrictions = 限制条件
loadouts-min-limit = 最少数量：{$count}
loadouts-max-limit = 最多数量：{$count}
loadouts-points-limit = 点数：{$count} / {$max}

loadouts-count-items-in-group = {$item} 以及其他 {$count} 件物品

loadouts-points-restriction = 点数不足
