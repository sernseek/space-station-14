### EmitterComponent

# Shows when attempting to turn the emitter on or off without proper access
comp-emitter-access-locked = {$target} 已被权限锁定！

# Shows when turning the emitter on/off
comp-emitter-turned-on = {$target} 开启了。

comp-emitter-turned-off = {$target} 关闭了。

# Shows if the user attempts to activate the emitter while it's un-anchored.
comp-emitter-not-anchored = {$target} 尚未锚定到地面！

emitter-component-current-type = 当前选择的类型为：[color=yellow]{$type}[/color]。
emitter-component-type-set = 类型已设为：{$type}
