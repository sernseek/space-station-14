# FTLdiskburner
cmd-ftldisk-desc = 创建一张超光速坐标盘，用于航行到指定 EntityID 所在的地图
cmd-ftldisk-help = 用法：ftldisk [EntityID]

cmd-ftldisk-no-transform = 实体 {$destination} 没有 Transform 组件！
cmd-ftldisk-no-map = 实体 {$destination} 没有地图！
cmd-ftldisk-no-map-comp = 实体 {$destination} 不知为何位于没有地图组件的地图 {$map} 上。
cmd-ftldisk-map-not-init = 实体 {$destination} 所在的地图 {$map} 尚未初始化！请确认初始化安全后先初始化地图，否则玩家将无法移动！
cmd-ftldisk-map-paused = 实体 {$desintation} 所在的地图 {$map} 已暂停！请先恢复地图运行，否则玩家将无法移动。
cmd-ftldisk-planet = 实体 {$desintation} 位于行星地图 {$map}，需要一个超光速航行点。该点可能已经存在。
cmd-ftldisk-already-dest-not-enabled = 实体 {$destination} 所在的地图 {$map} 已有 FTLDestinationComponent，但没有启用！为安全起见，请手动设置。
cmd-ftldisk-requires-ftl-point = 实体 {$destination} 所在的地图 {$map} 需要超光速航行点才能前往！该点可能已经存在。

cmd-ftldisk-hint = 地图 netID
